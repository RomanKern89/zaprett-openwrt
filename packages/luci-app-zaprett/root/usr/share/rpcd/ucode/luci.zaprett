#!/usr/bin/env ucode
// SPDX-License-Identifier: MIT
//
// rpcd ucode plugin: ubus object "luci.zaprett" for luci-app-zaprett.
//
// Every method validates its arguments and runs the zaprett CLI as
// "/usr/bin/zaprett <args...> --json", returning the parsed JSON object.
// Only the fs module and the ucode standard library are used, both are
// available in OpenWrt 24.10 and 25.12.
//
// The CLI is started with system() and an argument array: user data is
// passed as separate execve() arguments and never parsed by a shell. A tiny
// constant /bin/sh script only redirects stdin/stdout/stderr to files in a
// root-only temporary directory and then exec()s the CLI, so the time limit
// of system() kills the CLI itself. Output is read from a file, not from a
// pipe, so background processes of the backend cannot stall the call.
//
// rpcd executes ucode handlers synchronously: while the CLI runs, rpcd serves
// nothing else. Each method therefore has a short time limit; long operations
// (repository downloads, strategy auto-selection) are background jobs of the
// backend and return immediately.

'use strict';

import * as fs from 'fs';

const CLI = '/usr/bin/zaprett';
const TMPDIR = '/var/run/luci-zaprett';

const ID_RE = /^[A-Za-z0-9._-]{1,96}$/;
const USER_ID_RE = /^user-[A-Za-z0-9._-]{1,91}$/;
const SOURCE_NAME_RE = /^[a-z0-9_]{1,32}$/;
const SOURCE_URL_RE = /^https:\/\/[A-Za-z0-9.-]+(:[0-9]{1,5})?(\/[A-Za-z0-9._~%!$&'()*+,;=:@\/?#-]*)?$/;

const MAX_TEXT = 1048576;      // CLI limit for user lists and strategies
const MAX_OUTPUT = 4194304;    // largest CLI output read from the temporary file
const MAX_REPLY = 900000;      // ubus message limit is 1 MiB
const MAX_IDS = 100;
const MAX_SERVICES = 32;
const MAX_STRATEGIES = 200;
const MAX_SOURCES = 64;
const MAX_TAIL = 5000;
const MAX_TITLE = 128;
const MAX_URL = 2048;

const TIMEOUT_READ = 15;       // seconds
const TIMEOUT_CHANGE = 19;     // may restart the engine; LuCI RPC timeout is 20 s

const SERVICE_ACTIONS = [ 'start', 'stop', 'restart', 'enable', 'disable' ];
const ITEM_TYPES = [ 'list', 'list_exclude', 'ipset', 'ipset_exclude', 'nfqws', 'nfqws2', 'bin', 'lua_lib', 'byedpi' ];
const SOURCE_TYPES = [ 'list', 'list_exclude', 'ipset', 'ipset_exclude' ];

// $1 = stdin file, $2 = stdout file, $3 = stderr file, the rest is argv.
const EXEC_SCRIPT = 'in=$1; out=$2; err=$3; shift 3; exec "$@" <"$in" >"$out" 2>"$err"';

let tmpseq = 0;

function fail(code, message) {
	return { ok: false, error: code, message: message };
}

function is_id(v) {
	return type(v) == 'string' && match(v, ID_RE) != null;
}

function is_user_id(v) {
	return type(v) == 'string' && match(v, USER_ID_RE) != null;
}

function snippet(s) {
	s = trim(`${s ?? ''}`);

	return (length(s) > 400) ? substr(s, 0, 400) + '...' : s;
}

// Validates an optional array of ids; returns the de-duplicated array,
// or null when the value is invalid.
function id_list(v, max, allow_empty) {
	if (v == null)
		return allow_empty ? [] : null;

	if (type(v) != 'array' || length(v) > max || (!allow_empty && length(v) == 0))
		return null;

	let seen = {}, res = [];

	for (let id in v) {
		if (!is_id(id))
			return null;

		if (!seen[id]) {
			seen[id] = true;
			push(res, id);
		}
	}

	return res;
}

// Creates the private temporary directory (root only, mode 0700) and
// refuses to use it when it is a symlink or accessible by others.
function tmpdir() {
	let st = fs.lstat(TMPDIR);

	if (!st) {
		fs.mkdir(TMPDIR, 0o700);
		st = fs.lstat(TMPDIR);
	}

	if (!st || st.type != 'directory' || st.uid != 0 ||
	    st.perm?.group_write || st.perm?.other_read || st.perm?.other_write || st.perm?.other_exec)
		return null;

	return TMPDIR;
}

function tmpname(dir, kind) {
	tmpseq++;

	return sprintf('%s/%s.%d.%d', dir, kind, time(), tmpseq);
}

function cleanup(files) {
	for (let f in files)
		if (f)
			fs.unlink(f);
}

function reply_size(res) {
	return length(sprintf('%J', res));
}

// "test status" carries per-target details of every checked strategy; when the
// reply would not fit into one ubus message, the details are left out.
function trim_test_targets(res) {
	if (type(res.results?.results) != 'array')
		return res;

	for (let r in res.results.results)
		if (type(r) == 'object')
			delete r.targets;

	res.targets_trimmed = true;

	return res;
}

// Runs the CLI and returns the parsed JSON object or an error object.
//   args     - array of CLI arguments (already validated)
//   timeout  - time limit in seconds
//   input    - optional text for stdin
//   shrink   - optional function making an oversized reply smaller
function run(args, timeout, input, shrink) {
	if (!fs.access(CLI, 'x'))
		return fail('backend_missing', `${CLI} is not installed or not executable`);

	const dir = tmpdir();

	if (!dir)
		return fail('tmp_unavailable', `cannot use temporary directory ${TMPDIR}`);

	const outfile = tmpname(dir, 'out');
	const errfile = tmpname(dir, 'err');
	const infile = (input != null) ? tmpname(dir, 'in') : null;
	const files = [ infile, outfile, errfile ];

	if (infile && fs.writefile(infile, input) == null) {
		cleanup(files);

		return fail('tmp_unavailable', `cannot write temporary file: ${fs.error()}`);
	}

	const started = time();
	const rc = system([ '/bin/sh', '-c', EXEC_SCRIPT, 'zaprett-luci',
		infile ?? '/dev/null', outfile, errfile, CLI, ...args, '--json' ], timeout * 1000);
	const elapsed = time() - started;

	const outsize = fs.stat(outfile)?.size ?? 0;
	const out = (outsize <= MAX_OUTPUT) ? (fs.readfile(outfile) ?? '') : '';
	const errtext = fs.readfile(errfile, 4096) ?? '';

	cleanup(files);

	if (rc == -9 && elapsed >= timeout - 1)
		return fail('timeout', `${CLI} ${join(' ', args)} did not finish within ${timeout} s`);

	if (outsize > MAX_OUTPUT)
		return fail('reply_too_large', `output of ${CLI} ${join(' ', args)} is too large (${outsize} bytes)`);

	let res = null;

	try {
		res = json(trim(out));
	}
	catch (e) {
		res = null;
	}

	if (type(res) != 'object')
		return fail('backend_error',
			sprintf('%s %s exited with code %d and returned no valid JSON: %s',
				CLI, join(' ', args), rc, snippet(length(trim(out)) ? out : errtext)));

	if (type(res.ok) != 'bool')
		res.ok = (rc == 0);

	if (!res.ok) {
		res.error ??= 'backend_error';
		res.message ??= snippet(errtext);
	}

	if (reply_size(res) > MAX_REPLY && shrink)
		res = shrink(res);

	if (reply_size(res) > MAX_REPLY)
		return fail('reply_too_large', `reply of ${CLI} ${join(' ', args)} does not fit into one ubus message`);

	return res;
}

function source_list(v, allow_empty) {
	if (v == null)
		return allow_empty ? [] : null;

	if (type(v) != 'array' || length(v) > MAX_SOURCES || (!allow_empty && length(v) == 0))
		return null;

	let seen = {}, res = [];

	for (let name in v) {
		if (type(name) != 'string' || match(name, SOURCE_NAME_RE) == null)
			return null;

		if (!seen[name]) {
			seen[name] = true;
			push(res, name);
		}
	}

	return res;
}

function is_plain_text(v, max) {
	return type(v) == 'string' && length(v) <= max && match(v, /[[:cntrl:]]/) == null;
}

const methods = {
	status: {
		call: function(req) {
			return run([ 'status' ], TIMEOUT_READ);
		}
	},

	service: {
		args: { action: 'action' },
		call: function(req) {
			const action = req.args?.action;

			if (index(SERVICE_ACTIONS, action) < 0)
				return fail('invalid_argument', 'action must be one of: ' + join(', ', SERVICE_ACTIONS));

			return run([ action ], TIMEOUT_CHANGE);
		}
	},

	items: {
		args: { type: 'type' },
		call: function(req) {
			const t = req.args?.type;

			if (t == null || t == '')
				return run([ 'items' ], TIMEOUT_READ);

			if (index(ITEM_TYPES, t) < 0)
				return fail('invalid_argument', 'unknown item type');

			return run([ 'items', '--type', t ], TIMEOUT_READ);
		}
	},

	toggle_item: {
		args: { id: 'id', enabled: true },
		call: function(req) {
			const id = req.args?.id, enabled = req.args?.enabled;

			if (!is_id(id))
				return fail('invalid_id', 'invalid item id');

			if (type(enabled) != 'bool')
				return fail('invalid_argument', 'enabled must be a boolean');

			return run([ 'list', enabled ? 'enable' : 'disable', id ], TIMEOUT_CHANGE);
		}
	},

	set_strategy: {
		args: { id: 'id' },
		call: function(req) {
			if (!is_id(req.args?.id))
				return fail('invalid_id', 'invalid strategy id');

			return run([ 'strategy', 'set', req.args.id ], TIMEOUT_CHANGE);
		}
	},

	strategy_show: {
		args: { id: 'id' },
		call: function(req) {
			if (!is_id(req.args?.id))
				return fail('invalid_id', 'invalid strategy id');

			return run([ 'strategy', 'show', req.args.id ], TIMEOUT_READ);
		}
	},

	strategy_save: {
		args: { id: 'id', text: 'text' },
		call: function(req) {
			const id = req.args?.id, text = req.args?.text;

			if (!is_user_id(id))
				return fail('invalid_id', 'custom strategy id must start with "user-"');

			if (type(text) != 'string' || length(text) > MAX_TEXT)
				return fail('invalid_argument', 'text must be a string of at most 1 MiB');

			return run([ 'strategy', 'save', id ], TIMEOUT_CHANGE, text);
		}
	},

	strategy_delete: {
		args: { id: 'id' },
		call: function(req) {
			if (!is_user_id(req.args?.id))
				return fail('invalid_id', 'only custom strategies ("user-...") can be deleted');

			return run([ 'strategy', 'delete', req.args.id ], TIMEOUT_CHANGE);
		}
	},

	user_get: {
		args: { id: 'id' },
		call: function(req) {
			if (!is_user_id(req.args?.id))
				return fail('invalid_id', 'invalid user list id');

			return run([ 'user', 'get', req.args.id ], TIMEOUT_READ);
		}
	},

	user_set: {
		args: { id: 'id', text: 'text' },
		call: function(req) {
			const id = req.args?.id, text = req.args?.text;

			if (!is_user_id(id))
				return fail('invalid_id', 'invalid user list id');

			if (type(text) != 'string' || length(text) > MAX_TEXT)
				return fail('invalid_argument', 'text must be a string of at most 1 MiB');

			return run([ 'user', 'set', id ], TIMEOUT_CHANGE, text);
		}
	},

	check: {
		call: function(req) {
			return run([ 'check' ], TIMEOUT_READ);
		}
	},

	repo_fetch: {
		call: function(req) {
			return run([ 'repo', 'fetch' ], TIMEOUT_READ);
		}
	},

	repo_list: {
		args: { type: 'type' },
		call: function(req) {
			const t = req.args?.type;

			if (t == null || t == '')
				return run([ 'repo', 'list' ], TIMEOUT_READ);

			if (index(ITEM_TYPES, t) < 0)
				return fail('invalid_argument', 'unknown item type');

			return run([ 'repo', 'list', '--type', t ], TIMEOUT_READ);
		}
	},

	repo_install: {
		args: { ids: [] },
		call: function(req) {
			const ids = id_list(req.args?.ids, MAX_IDS, false);

			if (!ids)
				return fail('invalid_id', 'ids must be a non-empty array of valid ids');

			return run([ 'repo', 'install', ...ids ], TIMEOUT_READ);
		}
	},

	repo_remove: {
		args: { id: 'id' },
		call: function(req) {
			if (!is_id(req.args?.id))
				return fail('invalid_id', 'invalid item id');

			return run([ 'repo', 'remove', req.args.id ], TIMEOUT_READ);
		}
	},

	repo_upgrade: {
		args: { ids: [] },
		call: function(req) {
			const ids = id_list(req.args?.ids, MAX_IDS, true);

			if (!ids)
				return fail('invalid_id', 'ids must be an array of valid ids');

			return run(length(ids) ? [ 'repo', 'upgrade', ...ids ] : [ 'repo', 'upgrade', '--all' ], TIMEOUT_READ);
		}
	},

	presets: {
		call: function(req) {
			return run([ 'presets' ], TIMEOUT_READ);
		}
	},

	wizard_apply: {
		args: { services: [] },
		call: function(req) {
			const services = id_list(req.args?.services, MAX_SERVICES, false);

			if (!services)
				return fail('invalid_argument', 'services must be a non-empty array of service ids');

			return run([ 'wizard', 'apply', ...services ], TIMEOUT_CHANGE);
		}
	},

	sources_list: {
		call: function(req) {
			return run([ 'sources', 'list' ], TIMEOUT_READ);
		}
	},

	sources_update: {
		args: { names: [] },
		call: function(req) {
			const names = source_list(req.args?.names, true);

			if (!names)
				return fail('invalid_argument', 'names must be an array of subscription names');

			return run([ 'sources', 'update', ...names ], TIMEOUT_READ);
		}
	},

	source_save: {
		args: { name: 'name', title: 'title', type: 'type', url: 'url', interval_hours: 0, min_entries: 0, enabled: true },
		call: function(req) {
			const a = req.args ?? {};

			/* Only the name is required: the backend keeps the values of an existing
			 * subscription for every field that is left out (commands.uc source_values). */
			if (type(a.name) != 'string' || match(a.name, SOURCE_NAME_RE) == null)
				return fail('invalid_argument', 'name must match ^[a-z0-9_]{1,32}$');

			if (a.title != null && !is_plain_text(a.title, MAX_TITLE))
				return fail('invalid_argument', 'title must be a single-line string');

			if (a.type != null && index(SOURCE_TYPES, a.type) < 0)
				return fail('invalid_argument', 'type must be one of: ' + join(', ', SOURCE_TYPES));

			if (a.url != null && (type(a.url) != 'string' || length(a.url) > MAX_URL || match(a.url, SOURCE_URL_RE) == null))
				return fail('invalid_argument', 'url must be an https:// address');

			if (a.interval_hours != null && (type(a.interval_hours) != 'int' || a.interval_hours < 1 || a.interval_hours > 8760))
				return fail('invalid_argument', 'interval_hours must be an integer between 1 and 8760');

			if (a.min_entries != null && (type(a.min_entries) != 'int' || a.min_entries < 0 || a.min_entries > 100000000))
				return fail('invalid_argument', 'min_entries must be a non-negative integer');

			if (a.enabled != null && type(a.enabled) != 'bool')
				return fail('invalid_argument', 'enabled must be a boolean');

			const data = {};

			for (let k in [ 'title', 'type', 'url', 'interval_hours', 'min_entries', 'enabled' ])
				if (a[k] != null)
					data[k] = a[k];

			if (!length(keys(data)))
				return fail('invalid_argument', 'nothing to save: pass at least one field besides name');

			return run([ 'sources', 'save', a.name ], TIMEOUT_CHANGE, sprintf('%J', data));
		}
	},

	source_delete: {
		args: { name: 'name' },
		call: function(req) {
			const name = req.args?.name;

			if (type(name) != 'string' || match(name, SOURCE_NAME_RE) == null)
				return fail('invalid_argument', 'name must match ^[a-z0-9_]{1,32}$');

			return run([ 'sources', 'delete', name ], TIMEOUT_CHANGE);
		}
	},

	test_start: {
		args: { strategies: [], quick: false },
		call: function(req) {
			const strategies = id_list(req.args?.strategies, MAX_STRATEGIES, true);
			const quick = req.args?.quick;

			if (!strategies)
				return fail('invalid_id', 'strategies must be an array of valid strategy ids');

			if (quick != null && type(quick) != 'bool')
				return fail('invalid_argument', 'quick must be a boolean');

			const args = [ 'test', 'start' ];

			if (length(strategies))
				push(args, '--strategies', join(',', strategies));

			if (quick)
				push(args, '--quick');

			return run(args, TIMEOUT_READ);
		}
	},

	test_status: {
		call: function(req) {
			return run([ 'test', 'status' ], TIMEOUT_READ, null, trim_test_targets);
		}
	},

	test_stop: {
		call: function(req) {
			return run([ 'test', 'stop' ], TIMEOUT_CHANGE);
		}
	},

	test_apply: {
		args: { id: 'id' },
		call: function(req) {
			if (!is_id(req.args?.id))
				return fail('invalid_id', 'invalid strategy id');

			return run([ 'test', 'apply', req.args.id ], TIMEOUT_CHANGE);
		}
	},

	job_status: {
		call: function(req) {
			return run([ 'job', 'status' ], TIMEOUT_READ);
		}
	},

	job_log: {
		args: { tail: 0 },
		call: function(req) {
			const tail = req.args?.tail;

			if (tail == null)
				return run([ 'job', 'log' ], TIMEOUT_READ);

			if (type(tail) != 'int' || tail < 1 || tail > MAX_TAIL)
				return fail('invalid_argument', `tail must be an integer between 1 and ${MAX_TAIL}`);

			return run([ 'job', 'log', '--tail', tail ], TIMEOUT_READ);
		}
	},

	job_cancel: {
		call: function(req) {
			return run([ 'job', 'cancel' ], TIMEOUT_CHANGE);
		}
	},

	diag: {
		call: function(req) {
			return run([ 'diag' ], TIMEOUT_CHANGE);
		}
	}
};

return { 'luci.zaprett': methods };
