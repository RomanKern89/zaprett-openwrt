msgid "does not help"
msgstr "не помогает"

msgid "domains: %d, domain exclusions: %d, IP networks: %d, IP exclusions: %d"
msgstr "доменов: %d, исключений доменов: %d, IP-сетей: %d, исключений IP: %d"

msgid "enabled"
msgstr "включено"

msgid "enabled in the firewall"
msgstr "в межсетевом экране включено"

msgid "encryption error"
msgstr "ошибка шифрования"

