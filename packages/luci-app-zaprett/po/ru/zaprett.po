msgstr "Исходящие TCP-пакеты"

msgid "Outgoing UDP packets"
msgstr "Исходящие UDP-пакеты"

msgid "Overview"
msgstr "Обзор"

msgid "Parallel requests"
msgstr "Одновременных запросов"

msgid "Parameters of the check. Larger timeouts make the check slower but more reliable on slow connections."
msgstr "Параметры проверки. Чем больше время ожидания, тем дольше идёт проверка, но на медленном интернете она надёжнее."

msgid "Pause after restart, s"
msgstr "Пауза после перезапуска, с"

