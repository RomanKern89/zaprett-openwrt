
config main 'main'
	option enabled '0'
	option engine 'nfqws'
	option strategy 'strategy-general'
	option strategy_nfqws2 ''
	option list_mode 'whitelist'
	list lists 'zaprett-youtube'
	list lists 'zaprett-discord'
	list lists 'user-hosts'
	list exclude_lists 'zaprett-exclude'
	list exclude_lists 'user-hosts-exclude'
	list exclude_ipsets 'zaprett-exclude-ipset'
	list exclude_ipsets 'user-ipset-exclude'
	option qnum '200'
	option desync_mark '0x40000000'
	option postnat_mark '0x20000000'
	option ipv6 '0'
	option tcp_pkt_out '9'
	option tcp_pkt_in '3'
	option udp_pkt_out '9'
	option udp_pkt_in '0'
	option flow_offload 'own'
	option clients_mode 'all'
	option user 'daemon'
	option debug '0'
	option watchdog '1'
	option quic_block '0'
	option game_filter '0'
	option game_ports_tcp '1024-65535'
	option game_ports_udp '1024-65535'

config repo 'repo'
	option url 'https://raw.githubusercontent.com/CherretGit/zaprett-repo/refs/heads/main/index.json'
	option autoupdate '1'
	option autoupdate_hour '4'

config test 'test'
	option timeout '5'
	option concurrency '6'
	option max_domains '20'
	option settle '2'

config monitor 'monitor'
	option enabled '1'
	option interval '30'
	option threshold '3'
	option auto_repair '0'
	option max_targets '5'
	option timeout '8'

config source 'refilter_domains'
	option enabled '0'
	option name 'Re:filter — заблокированные домены'
	option type 'list'
	option url 'https://github.com/1andrevich/Re-filter-lists/releases/latest/download/domains_all.lst'
	option interval_hours '72'
	option min_entries '1000'
	option min_valid_ratio '0.99'
	option ram_mib '9'

config source 'antifilter_allyouneed'
	option enabled '0'
	option name 'antifilter — заблокированные IP-сети'
	option type 'ipset'
	option url 'https://antifilter.download/list/allyouneed.lst'
	option interval_hours '72'
	option min_entries '1000'
	option min_valid_ratio '0.99'
	option ram_mib '2'

config source 'cloudflare_v4'
	option enabled '0'
	option name 'Cloudflare — IPv4-сети'
	option type 'ipset'
	option url 'https://www.cloudflare.com/ips-v4'
	option interval_hours '168'
	option min_entries '5'
	option min_valid_ratio '0.99'
	option ram_mib '1'

config source 'cloudflare_v6'
	option enabled '0'
	option name 'Cloudflare — IPv6-сети'
	option type 'ipset'
	option url 'https://www.cloudflare.com/ips-v6'
	option interval_hours '168'
	option min_entries '3'
	option min_valid_ratio '0.99'
	option ram_mib '1'
