<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Zaprett.Ipc\Zaprett.Ipc.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>zaprett</AssemblyName>
    <RootNamespace>Zaprett.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Strings\*.json" LogicalName="Zaprett.Cli.Strings.%(Filename).json" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zaprett.Service.Tests" />
  </ItemGroup>

</Project>
