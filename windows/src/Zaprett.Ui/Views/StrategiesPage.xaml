<Page
    x:Class="Zaprett.Ui.Views.StrategiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Zaprett.Ui.Controls"
    xmlns:loc="using:Zaprett.Ui.Core.Loc"
    xmlns:vm="using:Zaprett.Ui.Core.ViewModels"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="18">
            <TextBlock Style="{StaticResource PageTitle}" Text="{x:Bind loc:L.T('Strategies.Title')}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Style="{StaticResource PageLead}" Text="{x:Bind loc:L.T('Strategies.Lead')}" />
            <InfoBar IsOpen="{x:Bind Vm.HasMessage, Mode=TwoWay}" Severity="{x:Bind ui:Conv.Severity(Vm.MessageKindValue), Mode=OneWay}"
                     Title="{x:Bind Vm.MessageTitle, Mode=OneWay}" Message="{x:Bind Vm.MessageText, Mode=OneWay}" />

            <!-- current strategy -->
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="52" Height="52" VerticalAlignment="Center">
                        <Ellipse ui:StateColor.Fill="accent-tint" />
                        <FontIcon Glyph="&#xE945;" FontSize="22" ui:StateColor.Foreground="accent" />
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Secondary}" Text="{x:Bind loc:L.T('Strategies.CurrentTitle')}" />
                        <TextBlock Text="{x:Bind Vm.CurrentName, Mode=OneWay}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{x:Bind Vm.EngineText, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- automatic selection -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="14">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Bind loc:L.T('Test.Title')}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{x:Bind loc:L.T('Test.Lead')}" MaxWidth="760" HorizontalAlignment="Left" />
                    <Grid ColumnSpacing="24" IsHitTestVisible="{x:Bind Vm.IsNotTesting, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton AutomationProperties.Name="{x:Bind loc:L.T('Test.Quick')}" AutomationProperties.HelpText="{x:Bind loc:L.T('Test.QuickText')}" GroupName="testmode" IsChecked="{x:Bind Vm.QuickMode, Mode=TwoWay}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="{x:Bind loc:L.T('Test.Quick')}" />
                                <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{x:Bind loc:L.T('Test.QuickText')}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton AutomationProperties.Name="{x:Bind loc:L.T('Test.Full')}" AutomationProperties.HelpText="{x:Bind loc:L.T('Test.FullText')}" Grid.Column="1" GroupName="testmode" IsChecked="{x:Bind Vm.FullMode, Mode=TwoWay}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="{x:Bind loc:L.T('Test.Full')}" />
                                <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{x:Bind loc:L.T('Test.FullText')}" />
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                    <CheckBox IsChecked="{x:Bind Vm.ApplyIfBetter, Mode=TwoWay}" Content="{x:Bind loc:L.T('Test.ApplyIfBetter')}" IsEnabled="{x:Bind Vm.IsNotTesting, Mode=OneWay}" />
                    <CheckBox AutomationProperties.Name="{x:Bind loc:L.T('Test.Exclusive')}" AutomationProperties.HelpText="{x:Bind loc:L.T('Test.ExclusiveText')}" IsChecked="{x:Bind Vm.ForceExclusive, Mode=TwoWay}" IsEnabled="{x:Bind Vm.IsNotTesting, Mode=OneWay}">
                        <StackPanel>
                            <TextBlock Text="{x:Bind loc:L.T('Test.Exclusive')}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{x:Bind loc:L.T('Test.ExclusiveText')}" />
                        </StackPanel>
                    </CheckBox>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button AutomationProperties.Name="{x:Bind loc:L.T('Test.Start')}" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.StartTestCommand}" Visibility="{x:Bind Vm.IsNotTesting, Mode=OneWay}" IsEnabled="{x:Bind Vm.CanModify, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock Text="{x:Bind loc:L.T('Test.Start')}" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{x:Bind loc:L.T('Test.Stop')}" Command="{x:Bind Vm.StopTestCommand}" Visibility="{x:Bind Vm.IsTesting, Mode=OneWay}" IsEnabled="{x:Bind Vm.CanModify, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                <TextBlock Text="{x:Bind loc:L.T('Test.Stop')}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Style="{StaticResource SubtleCard}" Visibility="{x:Bind Vm.Job.IsVisible, Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource CardTitle}" Text="{x:Bind Vm.Job.Title, Mode=OneWay}" />
                            <ProgressBar Value="{x:Bind Vm.Job.Percent, Mode=OneWay}" IsIndeterminate="False" />
                            <TextBlock Style="{StaticResource Secondary}" Text="{x:Bind Vm.Job.Message, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="{x:Bind Vm.ModeText, Mode=OneWay}"
                             Visibility="{x:Bind ui:Conv.ShowText(Vm.ModeText), Mode=OneWay}" />
                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{x:Bind Vm.ResultText, Mode=OneWay}"
                               Visibility="{x:Bind ui:Conv.ShowText(Vm.ResultText), Mode=OneWay}" />
                    <!-- collapsed as well as closed: a closed InfoBar still takes the spacing of the panel -->
                    <InfoBar IsOpen="{x:Bind ui:Conv.HasText(Vm.ConflictNote), Mode=OneWay}" IsClosable="False" Severity="Warning"
                             Message="{x:Bind Vm.ConflictNote, Mode=OneWay}" Visibility="{x:Bind ui:Conv.ShowText(Vm.ConflictNote), Mode=OneWay}" />

                    <StackPanel Spacing="6" Visibility="{x:Bind Vm.HasResults, Mode=OneWay}">
                        <Grid>
                            <TextBlock Style="{StaticResource Secondary}" VerticalAlignment="Center" Text="{x:Bind Vm.BaselineText, Mode=OneWay}" />
                            <Button HorizontalAlignment="Right" Content="{x:Bind loc:L.T('Test.ApplyBest')}" Command="{x:Bind Vm.ApplyBestCommand}" IsEnabled="{x:Bind Vm.CanModify, Mode=OneWay}" />
                        </Grid>
                        <Grid Padding="12,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="#" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Secondary}" FontSize="12" Text="{x:Bind loc:L.T('Test.Col.Strategy')}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Secondary}" FontSize="12" Text="{x:Bind loc:L.T('Test.Col.Opened')}" />
                            <TextBlock Grid.Column="3" Style="{StaticResource Secondary}" FontSize="12" Text="{x:Bind loc:L.T('Test.Col.Share')}" />
                            <TextBlock Grid.Column="4" Style="{StaticResource Secondary}" FontSize="12" Text="{x:Bind loc:L.T('Test.Col.Time')}" />
                        </Grid>
                        <ItemsRepeater ItemsSource="{x:Bind Vm.Results}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="4" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:TestRow">
                                    <Grid Padding="12,8" ColumnSpacing="12" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Rank}" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Name}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Score}" FontWeight="SemiBold" VerticalAlignment="Center" ui:StateColor.Foreground="{x:Bind Kind}" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind StatusLabel}" Style="{StaticResource Secondary}" FontSize="12" VerticalAlignment="Center"
                                                   Visibility="{x:Bind HasStatus}" TextWrapping="Wrap" />
                                        <Grid Grid.Column="3" ColumnSpacing="8" VerticalAlignment="Center" Visibility="{x:Bind ui:Conv.Hide(HasStatus)}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="44" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Height="6" CornerRadius="3" Background="{ThemeResource ControlStrokeColorDefaultBrush}" VerticalAlignment="Center">
                                                <ProgressBar Value="{x:Bind Bar}" Maximum="100" Background="Transparent" MinHeight="6" ui:StateColor.Foreground="{x:Bind Kind}" />
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Percent}" Style="{StaticResource Secondary}" FontSize="12" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Grid.Column="4" Text="{x:Bind Time}" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                                        <Button Grid.Column="5" HorizontalAlignment="Right" Padding="10,3" FontSize="12" Content="{x:Bind loc:L.T('Test.Apply')}"
                                                Visibility="{x:Bind CanApply}" Click="OnApplyRow" Tag="{x:Bind}" />
                                        <TextBlock Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Secondary}" FontSize="12"
                                                   Text="{x:Bind loc:L.T('Strategies.Current')}" Visibility="{x:Bind IsCurrent}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- installed strategies and the editor -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="12,16" VerticalAlignment="Top">
                    <StackPanel Spacing="10">
                        <Grid Padding="8,0">
                            <TextBlock Style="{StaticResource SectionTitle}" FontSize="17" Text="{x:Bind loc:L.T('Strategies.Installed')}" VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right" Command="{x:Bind Vm.NewStrategyCommand}" ToolTipService.ToolTip="{x:Bind loc:L.T('Strategies.New')}"
                                    AutomationProperties.Name="{x:Bind loc:L.T('Strategies.New')}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="{x:Bind loc:L.T('Strategies.New')}" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ListView ItemsSource="{x:Bind Vm.Strategies}" SelectedItem="{x:Bind Vm.Selected, Mode=TwoWay}" MaxHeight="520" SelectionMode="Single"
                                  AutomationProperties.Name="{x:Bind loc:L.T('Strategies.Installed')}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:StrategyItem">
                                    <StackPanel Padding="0,8" Spacing="2" AutomationProperties.Name="{x:Bind Name}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind ActiveLabel}" FontSize="12" ui:StateColor.Foreground="ok" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind SourceLabel}" Style="{StaticResource Secondary}" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <Grid>
                        <StackPanel Spacing="12" Visibility="{x:Bind Vm.HasSelection, Mode=OneWay}">
                            <TextBlock Style="{StaticResource SectionTitle}" FontSize="17" Text="{x:Bind loc:L.T('Strategies.Editor')}" />
                            <TextBlock Style="{StaticResource Secondary}" Text="{x:Bind Vm.SelectedInfo, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{x:Bind loc:L.T('Strategies.Name')}" />
                            <TextBox Text="{x:Bind Vm.EditorName, Mode=TwoWay}" FontFamily="{StaticResource MonoFont}" Margin="0,-6,0,0"
                                     AutomationProperties.Name="{x:Bind loc:L.T('Strategies.Name')}" />
                            <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{x:Bind loc:L.T('Strategies.Text')}" Visibility="{x:Bind Vm.IsEditable, Mode=OneWay}" />
                            <TextBox Text="{x:Bind Vm.EditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,-6,0,0"
                                     AutomationProperties.Name="{x:Bind loc:L.T('Strategies.Text')}"
                                     AcceptsReturn="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                     MinHeight="120" MaxHeight="260" IsSpellCheckEnabled="False" Visibility="{x:Bind Vm.IsEditable, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{x:Bind loc:L.T('Strategies.Preview')}" />
                            <Border Style="{StaticResource SubtleCard}">
                                <ui:StrategyText Text="{x:Bind Vm.EditorText, Mode=OneWay}" />
                            </Border>
                            <StackPanel Spacing="10">
                                <Button AutomationProperties.Name="{x:Bind loc:L.T('Strategies.SaveCheck')}" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.SaveAndCheckCommand}" HorizontalAlignment="Stretch" IsEnabled="{x:Bind Vm.CanModify, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ProgressRing IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}" Visibility="{x:Bind Vm.IsBusy, Mode=OneWay}" Width="16" Height="16" />
                                        <TextBlock Text="{x:Bind loc:L.T('Strategies.SaveCheck')}" />
                                    </StackPanel>
                                </Button>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="{x:Bind loc:L.T('Strategies.MakeCurrent')}" Command="{x:Bind Vm.SelectCommand}" CommandParameter="{x:Bind Vm.Selected, Mode=OneWay}"
                                            HorizontalAlignment="Stretch" IsEnabled="{x:Bind Vm.CanModify, Mode=OneWay}" />
                                    <Button Grid.Column="1" Content="{x:Bind loc:L.T('Common.Delete')}" Command="{x:Bind Vm.DeleteCommand}" Visibility="{x:Bind Vm.IsEditable, Mode=OneWay}" IsEnabled="{x:Bind Vm.CanModify, Mode=OneWay}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="8" Visibility="{x:Bind Vm.HasCheck, Mode=OneWay}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" VerticalAlignment="Top" Margin="0,6,0,0" ui:StateColor.Fill="{x:Bind Vm.CheckKind, Mode=OneWay}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Vm.CheckText, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock Style="{StaticResource Secondary}" Text="{x:Bind Vm.PortsText, Mode=OneWay}" Visibility="{x:Bind ui:Conv.ShowText(Vm.PortsText), Mode=OneWay}" />
                                <ItemsControl ItemsSource="{x:Bind Vm.CheckWarnings}" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WarningItem">
                                            <InfoBar IsOpen="True" IsClosable="False" Severity="{x:Bind ui:Conv.Severity(Kind)}" Title="{x:Bind Title}" Message="{x:Bind Text}" Margin="0,0,0,6" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{x:Bind loc:L.T('Diag.EngineOutput')}" Visibility="{x:Bind ui:Conv.ShowText(Vm.EngineOutput), Mode=OneWay}" />
                                <Border Style="{StaticResource SubtleCard}" Visibility="{x:Bind ui:Conv.ShowText(Vm.EngineOutput), Mode=OneWay}">
                                    <TextBlock Style="{StaticResource Mono}" Text="{x:Bind Vm.EngineOutput, Mode=OneWay}" />
                                </Border>
                                <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{x:Bind loc:L.T('Diag.EngineArgs')}" Visibility="{x:Bind ui:Conv.ShowText(Vm.ArgsText), Mode=OneWay}" />
                                <Border Style="{StaticResource SubtleCard}" Visibility="{x:Bind ui:Conv.ShowText(Vm.ArgsText), Mode=OneWay}">
                                    <TextBlock Style="{StaticResource Mono}" Text="{x:Bind Vm.ArgsText, Mode=OneWay}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="8" Visibility="{x:Bind ui:Conv.Hide(Vm.HasSelection), Mode=OneWay}" Padding="0,24" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE70F;" FontSize="28" ui:StateColor.Foreground="none" />
                            <TextBlock Style="{StaticResource Secondary}" TextAlignment="Center" MaxWidth="360" Text="{x:Bind loc:L.T('Strategies.PickHint')}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
