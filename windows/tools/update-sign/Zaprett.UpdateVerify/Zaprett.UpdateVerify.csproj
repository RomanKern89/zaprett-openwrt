<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Zaprett.UpdateVerify</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ed25519: .NET 10 has no standalone Ed25519 API; BouncyCastle is fully managed (MIT-style licence). -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zaprett.UpdateVerify.Tests" />
  </ItemGroup>

</Project>
