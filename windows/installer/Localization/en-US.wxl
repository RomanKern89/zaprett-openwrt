<WixLocalization Culture="en-US" Codepage="1252" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="ZaprettFontFace" Value="Tahoma" />
  <String Id="ProductLanguage" Value="1033" />
  <String Id="DefaultUiLanguage" Value="en" />
  <String Id="LicenseFile" Value="License.en-US.rtf" />
  <String Id="ProductDescription" Value="zaprett: DPI circumvention with the zapret engine for this PC" />
  <String Id="DowngradeError" Value="A newer version of zaprett is already installed. Setup will now exit." />
  <String Id="RequiresX64" Value="zaprett runs on 64-bit Windows (x64) only." />
  <String Id="RequiresWin10" Value="zaprett requires Windows 10 version 2004 (build 19041) or newer." />
  <String Id="ServiceDisplayName" Value="zaprett" />
  <String Id="ServiceDescription" Value="zaprett service: runs the DPI circumvention engine (winws) and keeps the settings." />
  <String Id="ShortcutDescription" Value="Control zaprett DPI circumvention" />
  <String Id="FeatureCoreTitle" Value="zaprett" />
  <String Id="FeatureCoreDescription" Value="Service, user interface, command line, winws engine, strategies and lists." />
  <String Id="FeatureEngine2Title" Value="zapret2 engine (winws2)" />
  <String Id="FeatureEngine2Description" Value="Second engine with Lua strategies." />
